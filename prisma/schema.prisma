generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// User Profiles (linked to Supabase Auth's auth.users)
// ---------------------------------------------------------------------------

enum UserRole {
  owner
  admin
  member
  viewer
}

enum UserStatus {
  active
  deactivated
}

enum UserInviteStatus {
  pending
  accepted
  cancelled
}

// ---------------------------------------------------------------------------
// Access control (office IP / device restriction) — Phase 1 schema only.
// Nothing enforces these yet; helpers and enforcement land in later phases.
// ---------------------------------------------------------------------------

enum AccessMode {
  unrestricted
  ip
  device
  ip_and_device
  ip_or_device
}

enum DeviceStatus {
  pending
  approved
  revoked
}

model UserProfile {
  id         String     @id @default(uuid()) @db.Uuid
  authId     String     @unique @map("auth_id") @db.Uuid
  email      String     @unique
  name       String?
  role       UserRole   @default(member)
  status     UserStatus @default(active)
  accessMode AccessMode @default(unrestricted) @map("access_mode")
  accessCode String?    @unique @map("access_code")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  folders       Folder[]
  files         File[]
  fileVersions  FileVersion[]
  auditEvents   AuditEvent[]
  auditStars    AuditStar[]
  notifications Notification[]
  invitesSent   UserInvite[] @relation("InvitedBy")

  allowedIpRanges   AllowedIpRange[] @relation("UserAllowedIps")
  allowedIpsCreated AllowedIpRange[] @relation("AllowedIpCreatedBy")
  approvedDevices   ApprovedDevice[] @relation("UserApprovedDevices")
  devicesApproved   ApprovedDevice[] @relation("DeviceApprovedBy")

  @@map("user_profiles")
}

// Allowed IP/CIDR ranges. `userId` null means the range applies workspace-wide
// (e.g. the shared office IP); a set `userId` scopes it to one member.
model AllowedIpRange {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  value       String
  label       String?
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  user      UserProfile? @relation("UserAllowedIps", fields: [userId], references: [id], onDelete: Cascade)
  createdBy UserProfile  @relation("AllowedIpCreatedBy", fields: [createdById], references: [id])

  @@index([userId])
  @@map("allowed_ip_ranges")
}

// Browser-bound approved devices. `userId` null means a shared office device
// usable by any restricted member; a set `userId` scopes it to one member.
// Only the SHA-256 hash of the device token is stored.
model ApprovedDevice {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String?      @map("user_id") @db.Uuid
  tokenHash    String       @unique @map("token_hash")
  status       DeviceStatus @default(pending)
  userAgent    String?      @map("user_agent")
  browser      String?
  deviceLabel  String?      @map("device_label")
  lastIp       String?      @map("last_ip")
  createdAt    DateTime     @default(now()) @map("created_at")
  approvedAt   DateTime?    @map("approved_at")
  approvedById String?      @map("approved_by_id") @db.Uuid
  lastSeenAt   DateTime?    @map("last_seen_at")
  revokedAt    DateTime?    @map("revoked_at")

  user       UserProfile? @relation("UserApprovedDevices", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy UserProfile? @relation("DeviceApprovedBy", fields: [approvedById], references: [id])

  @@index([userId])
  @@index([status])
  @@map("approved_devices")
}

model UserInvite {
  id         String           @id @default(uuid()) @db.Uuid
  email      String           @unique
  role       UserRole
  status     UserInviteStatus @default(pending)
  invitedBy  String           @map("invited_by") @db.Uuid
  invitedAt  DateTime         @default(now()) @map("invited_at")
  acceptedAt DateTime?        @map("accepted_at")

  inviter UserProfile @relation("InvitedBy", fields: [invitedBy], references: [id])

  @@index([status])
  @@map("user_invites")
}

// ---------------------------------------------------------------------------
// Folders
// ---------------------------------------------------------------------------

model Folder {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  parentId  String?   @map("parent_id") @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")
  owner    UserProfile @relation(fields: [ownerId], references: [id])
  files    File[]

  @@index([parentId])
  @@index([ownerId])
  @@map("folders")
}

// ---------------------------------------------------------------------------
// Files
// ---------------------------------------------------------------------------

model File {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  mimeType         String?   @map("mime_type")
  folderId         String?   @map("folder_id") @db.Uuid
  ownerId          String    @map("owner_id") @db.Uuid
  currentVersionId String?   @unique @map("current_version_id") @db.Uuid
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  folder         Folder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  owner          UserProfile  @relation(fields: [ownerId], references: [id])
  currentVersion FileVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions       FileVersion[] @relation("FileVersions")

  @@index([folderId])
  @@index([ownerId])
  @@index([name])
  @@map("files")
}

// ---------------------------------------------------------------------------
// File Versions
// ---------------------------------------------------------------------------

model FileVersion {
  id         String   @id @default(uuid()) @db.Uuid
  fileId     String   @map("file_id") @db.Uuid
  versionNo  Int      @map("version_no")
  sizeBytes  BigInt   @map("size_bytes")
  storageKey String   @map("storage_key")
  uploadedBy String   @map("uploaded_by") @db.Uuid
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  file       File        @relation("FileVersions", fields: [fileId], references: [id], onDelete: Cascade)
  uploader   UserProfile @relation(fields: [uploadedBy], references: [id])
  currentOf  File?       @relation("CurrentVersion")

  @@unique([fileId, versionNo])
  @@index([fileId])
  @@map("file_versions")
}

// ---------------------------------------------------------------------------
// Storage Usage
// ---------------------------------------------------------------------------

model StorageUsage {
  id         String   @id @default(uuid()) @db.Uuid
  totalBytes BigInt   @default(0) @map("total_bytes")
  fileCount  Int      @default(0) @map("file_count")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("storage_usage")
}

// ---------------------------------------------------------------------------
// Workspace Settings (key-value)
// ---------------------------------------------------------------------------

model WorkspaceSetting {
  key   String @id
  value String

  @@map("workspace_settings")
}

// ---------------------------------------------------------------------------
// Audit Events
// ---------------------------------------------------------------------------

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  role       String?
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  meta       Json?    @db.JsonB
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  actor UserProfile? @relation(fields: [actorId], references: [id])
  stars AuditStar[]

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Starred audit events (per-user pins; references audit row only)
// ---------------------------------------------------------------------------

model AuditStar {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  auditEventId String   @map("audit_event_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  user       UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditEvent AuditEvent  @relation(fields: [auditEventId], references: [id], onDelete: Cascade)

  @@unique([userId, auditEventId])
  @@index([userId])
  @@index([auditEventId])
  @@map("audit_stars")
}

// ---------------------------------------------------------------------------
// Favorites (pinned files/folders)
// ---------------------------------------------------------------------------

model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  targetType String   @map("target_type") // 'file' | 'folder'
  targetId   String   @map("target_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@map("favorites")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  payload   Json?     @db.JsonB
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user UserProfile @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("notifications")
}
