generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// User Profiles (linked to Supabase Auth's auth.users)
// ---------------------------------------------------------------------------

enum UserRole {
  owner
  admin
  member
  viewer
}

enum UserStatus {
  active
  deactivated
}

enum UserInviteStatus {
  pending
  accepted
  cancelled
}

// ---------------------------------------------------------------------------
// Access control (office IP / device restriction) — Phase 1 schema only.
// Nothing enforces these yet; helpers and enforcement land in later phases.
// ---------------------------------------------------------------------------

enum AccessMode {
  unrestricted
  ip
  device
  ip_and_device
  ip_or_device
}

enum DeviceStatus {
  pending
  approved
  revoked
}

model UserProfile {
  id         String     @id @default(uuid()) @db.Uuid
  authId     String     @unique @map("auth_id") @db.Uuid
  email      String     @unique
  name       String?
  role       UserRole   @default(member)
  status     UserStatus @default(active)
  accessMode AccessMode @default(unrestricted) @map("access_mode")
  accessCode String?    @unique @map("access_code")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  folders       Folder[]
  files         File[]
  fileVersions  FileVersion[]
  auditEvents   AuditEvent[]
  auditStars    AuditStar[]
  notifications Notification[]
  invitesSent   UserInvite[] @relation("InvitedBy")

  allowedIpRanges   AllowedIpRange[] @relation("UserAllowedIps")
  allowedIpsCreated AllowedIpRange[] @relation("AllowedIpCreatedBy")
  approvedDevices   ApprovedDevice[] @relation("UserApprovedDevices")
  devicesApproved   ApprovedDevice[] @relation("DeviceApprovedBy")


  // --- MIS (additive; no column is added to user_profiles by these) ---
  misEmployee    MisEmployee?
  misPreference  MisUserPreference?
  misAuditEvents MisAuditLog[]     @relation("MisAuditActor")

  @@map("user_profiles")
}

// Allowed IP/CIDR ranges. `userId` null means the range applies workspace-wide
// (e.g. the shared office IP); a set `userId` scopes it to one member.
model AllowedIpRange {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  value       String
  label       String?
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  user      UserProfile? @relation("UserAllowedIps", fields: [userId], references: [id], onDelete: Cascade)
  createdBy UserProfile  @relation("AllowedIpCreatedBy", fields: [createdById], references: [id])

  @@index([userId])
  @@map("allowed_ip_ranges")
}

// Browser-bound approved devices. `userId` null means a shared office device
// usable by any restricted member; a set `userId` scopes it to one member.
// Only the SHA-256 hash of the device token is stored.
model ApprovedDevice {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String?      @map("user_id") @db.Uuid
  tokenHash    String       @unique @map("token_hash")
  status       DeviceStatus @default(pending)
  userAgent    String?      @map("user_agent")
  browser      String?
  deviceLabel  String?      @map("device_label")
  lastIp       String?      @map("last_ip")
  createdAt    DateTime     @default(now()) @map("created_at")
  approvedAt   DateTime?    @map("approved_at")
  approvedById String?      @map("approved_by_id") @db.Uuid
  lastSeenAt   DateTime?    @map("last_seen_at")
  revokedAt    DateTime?    @map("revoked_at")

  user       UserProfile? @relation("UserApprovedDevices", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy UserProfile? @relation("DeviceApprovedBy", fields: [approvedById], references: [id])

  @@index([userId])
  @@index([status])
  @@map("approved_devices")
}

model UserInvite {
  id         String           @id @default(uuid()) @db.Uuid
  email      String           @unique
  role       UserRole
  status     UserInviteStatus @default(pending)
  invitedBy  String           @map("invited_by") @db.Uuid
  invitedAt  DateTime         @default(now()) @map("invited_at")
  acceptedAt DateTime?        @map("accepted_at")

  inviter UserProfile @relation("InvitedBy", fields: [invitedBy], references: [id])

  @@index([status])
  @@map("user_invites")
}

// ---------------------------------------------------------------------------
// Folders
// ---------------------------------------------------------------------------

model Folder {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  parentId  String?   @map("parent_id") @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")
  owner    UserProfile @relation(fields: [ownerId], references: [id])
  files    File[]

  @@index([parentId])
  @@index([ownerId])
  @@map("folders")
}

// ---------------------------------------------------------------------------
// Files
// ---------------------------------------------------------------------------

model File {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  mimeType         String?   @map("mime_type")
  folderId         String?   @map("folder_id") @db.Uuid
  ownerId          String    @map("owner_id") @db.Uuid
  currentVersionId String?   @unique @map("current_version_id") @db.Uuid
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  folder         Folder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  owner          UserProfile  @relation(fields: [ownerId], references: [id])
  currentVersion FileVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions       FileVersion[] @relation("FileVersions")

  @@index([folderId])
  @@index([ownerId])
  @@index([name])
  @@map("files")
}

// ---------------------------------------------------------------------------
// File Versions
// ---------------------------------------------------------------------------

model FileVersion {
  id         String   @id @default(uuid()) @db.Uuid
  fileId     String   @map("file_id") @db.Uuid
  versionNo  Int      @map("version_no")
  sizeBytes  BigInt   @map("size_bytes")
  storageKey String   @map("storage_key")
  uploadedBy String   @map("uploaded_by") @db.Uuid
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  file       File        @relation("FileVersions", fields: [fileId], references: [id], onDelete: Cascade)
  uploader   UserProfile @relation(fields: [uploadedBy], references: [id])
  currentOf  File?       @relation("CurrentVersion")

  @@unique([fileId, versionNo])
  @@index([fileId])
  @@map("file_versions")
}

// ---------------------------------------------------------------------------
// Storage Usage
// ---------------------------------------------------------------------------

model StorageUsage {
  id         String   @id @default(uuid()) @db.Uuid
  totalBytes BigInt   @default(0) @map("total_bytes")
  fileCount  Int      @default(0) @map("file_count")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("storage_usage")
}

// ---------------------------------------------------------------------------
// Workspace Settings (key-value)
// ---------------------------------------------------------------------------

model WorkspaceSetting {
  key   String @id
  value String

  @@map("workspace_settings")
}

// ---------------------------------------------------------------------------
// Audit Events
// ---------------------------------------------------------------------------

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  role       String?
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  meta       Json?    @db.JsonB
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  actor UserProfile? @relation(fields: [actorId], references: [id])
  stars AuditStar[]

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Starred audit events (per-user pins; references audit row only)
// ---------------------------------------------------------------------------

model AuditStar {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  auditEventId String   @map("audit_event_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  user       UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditEvent AuditEvent  @relation(fields: [auditEventId], references: [id], onDelete: Cascade)

  @@unique([userId, auditEventId])
  @@index([userId])
  @@index([auditEventId])
  @@map("audit_stars")
}

// ---------------------------------------------------------------------------
// Favorites (pinned files/folders)
// ---------------------------------------------------------------------------

model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  targetType String   @map("target_type") // 'file' | 'folder'
  targetId   String   @map("target_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@map("favorites")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  payload   Json?     @db.JsonB
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user UserProfile @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// MIS — Factory Management Information System
//
// Everything below is prefixed Mis* and is a PARALLEL system. The existing
// UserRole enum and the live file-management tables are not touched: adding a
// value to a live enum is the fastest way to break a running product.
// ---------------------------------------------------------------------------

/// The seven MIS roles. Deliberately separate from UserRole.
enum MisRole {
  OWNER
  ADMIN
  SUPERVISOR
  QC
  ATTENDANCE_OPERATOR
  SUPER_ATTENDANCE_OPERATOR
  WORKER
  STORE_GUY
}

/// A person on the factory roll.
///
/// userProfileId is NULLABLE on purpose: a WORKER has no login at all. That is
/// the normal case, not an error case — most of the roll will never sign in.
model MisEmployee {
  id            String   @id @default(uuid()) @db.Uuid
  userProfileId String?  @unique @map("user_profile_id") @db.Uuid
  employeeCode  String   @unique @map("employee_code")
  name          String
  nameHi        String?  @map("name_hi")
  role          MisRole  @default(WORKER)
  managerId     String?  @map("manager_id") @db.Uuid
  departmentId  String?  @map("department_id") @db.Uuid
  isActive      Boolean  @default(true) @map("is_active")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  userProfile   UserProfile?      @relation(fields: [userProfileId], references: [id], onDelete: SetNull)
  manager       MisEmployee?      @relation("MisReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports       MisEmployee[]     @relation("MisReports")
  department    MisDepartment?    @relation(fields: [departmentId], references: [id])
  attendance    MisAttendance[]
  leaveRequests MisLeaveRequest[]
  productionLogs MisProductionLog[]
  jobPhasesInCharge MisJobPhase[] @relation("MisJobPhaseInCharge")
  workerAllocations MisWorkerAllocation[]
  punches       MisAttendancePunch[]

  @@index([role])
  @@index([managerId])
  @@index([departmentId])
  @@index([deletedAt])
  @@map("mis_employees")
}

/// Per-user MIS preferences.
///
/// A separate table rather than a column on user_profiles, so the live product's
/// own table keeps exactly the shape it has today.
model MisUserPreference {
  userProfileId String   @id @map("user_profile_id") @db.Uuid
  locale        String   @default("en")
  updatedAt     DateTime @updatedAt @map("updated_at")

  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@map("mis_user_preferences")
}

/// Every write the MIS makes, with a before/after diff.
///
/// Wage amounts are never written into `before`/`after` for an entity a
/// non-owner can read back (S9). The redaction happens in server/mis/audit.ts.
model MisAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  actor UserProfile? @relation("MisAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("mis_audit_logs")
}

/// One row per option in every simple dropdown in the system.
///
/// `group` is a String, not an enum, so an eighth group costs a row rather than
/// a migration — which is the whole point of this table.
model MisMasterOption {
  id        String    @id @default(uuid()) @db.Uuid
  group     String
  value     String
  label     String
  labelHi   String?   @map("label_hi")
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // A value is unique within its group among rows that are not soft-deleted.
  // Postgres treats NULLs as distinct, so a deleted row never blocks a re-add.
  @@unique([group, value, deletedAt])
  @@index([group, sortOrder])
  @@map("mis_master_options")
}

// ---------------------------------------------------------------------------
// MIS Entity Masters — Phase 2
// ---------------------------------------------------------------------------

enum MisPoStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  RECEIVING
  PARTIAL
  COMPLETE
  CANCELLED
  @@map("mis_po_status")
}

enum MisGrnStatus {
  DRAFT
  CONFIRMED
  @@map("mis_grn_status")
}

enum MisGrnItemType {
  GENERAL
  FOR_ORDER
  @@map("mis_grn_item_type")
}

enum MisItemCategory {
  RAW_MATERIAL
  CONSUMABLE
  EQUIPMENT
  OTHER
}

enum MisItemUnit {
  KG
  LITRE
  PIECE
  REAM
}

enum MisStoreTxnType {
  IN
  OUT
}

model MisDepartment {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique @map("code")
  name      String
  nameHi    String?   @map("name_hi")
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  machines  MisMachine[]
  processes MisProcess[]
  employees MisEmployee[]
  @@map("mis_departments")
}

model MisDefectType {
  id        String              @id @default(uuid()) @db.Uuid
  code      String              @unique @map("code")
  name      String
  nameHi    String?             @map("name_hi")
  severity  MisDefectSeverity   @map("severity")
  isActive  Boolean             @default(true) @map("is_active")
  sortOrder Int                 @default(0) @map("sort_order")
  deletedAt DateTime?           @map("deleted_at")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  @@map("mis_defect_types")
}

model MisMachine {
  id             String         @id @default(uuid()) @db.Uuid
  code           String         @unique
  name           String
  departmentId   String?        @map("department_id") @db.Uuid
  machineType    String?        @map("machine_type")
  capacityPerDay Decimal?       @map("capacity_per_day") @db.Decimal(12,2)
  isActive       Boolean        @default(true) @map("is_active")
  sortOrder      Int            @default(0) @map("sort_order")
  deletedAt      DateTime?      @map("deleted_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  department     MisDepartment? @relation(fields: [departmentId], references: [id])
  allocations    MisMachineAllocation[]
  productionLogs MisProductionLog[]
  lineClearances MisLineClearance[]
  @@map("mis_machines")
}

model MisCustomer {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique
  name      String
  nameHi    String?   @map("name_hi")
  phone     String?
  address   String?
  city      String?
  gstNo     String?   @map("gst_no")
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  orders    MisOrder[]
  @@map("mis_customers")
}

model MisSupplier {
  id               String    @id @default(uuid()) @db.Uuid
  code             String    @unique
  name             String
  phone            String?
  address          String?
  city             String?
  gstNo            String?   @map("gst_no")
  paymentTermsDays Int?      @map("payment_terms_days")
  isActive         Boolean   @default(true) @map("is_active")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  purchaseOrders   MisPurchaseOrder[]
  @@map("mis_suppliers")
}

model MisItem {
  id             String           @id @default(uuid()) @db.Uuid
  code           String           @unique
  sku            String?          @unique @map("sku")
  name           String
  category       MisItemCategory  @default(OTHER)
  gsm            String?
  size           String?
  substrate      String?
  coating        String?
  unit           MisItemUnit      @default(KG)
  pricePerUnit   Decimal?         @map("price_per_unit") @db.Decimal(12, 2)
  isDemo         Boolean          @default(true) @map("is_demo")
  reorderLevel   Decimal?         @map("reorder_level") @db.Decimal(12, 2)
  isActive       Boolean          @default(true) @map("is_active")
  deletedAt      DateTime?        @map("deleted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  poItems        MisPoItem[]
  inventory      MisInventoryLedger[]
  storeTxns      MisStoreTransaction[]
  physicalCounts MisPhysicalCount[]
  bomMaterials   MisBomMaterial[]
  @@map("mis_items")
}

model MisProcess {
  id                  String         @id @default(uuid()) @db.Uuid
  code                String         @unique
  name                String
  nameHi              String?        @map("name_hi")
  departmentId        String?        @map("department_id") @db.Uuid
  standardTimeMinutes Int?           @map("standard_time_minutes")
  isActive            Boolean        @default(true) @map("is_active")
  sortOrder           Int            @default(0) @map("sort_order")
  deletedAt           DateTime?      @map("deleted_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  department          MisDepartment? @relation(fields: [departmentId], references: [id])
  bomStages           MisBomStage[]
  jobPhases           MisJobPhase[]
  @@map("mis_processes")
}

model MisPurchaseOrder {
  id           String       @id @default(uuid()) @db.Uuid
  poNumber     String       @unique @map("po_number")
  supplierId   String?      @map("supplier_id") @db.Uuid
  status       MisPoStatus  @default(DRAFT)
  bomRef       String?      @map("bom_ref")
  notes        String?
  createdById  String?      @map("created_by_id") @db.Uuid
  approvedById String?      @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?    @map("approved_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  supplier     MisSupplier? @relation(fields: [supplierId], references: [id])
  items        MisPoItem[]
  grns         MisGrn[]
  @@map("mis_purchase_orders")
}

model MisPoItem {
  id               String           @id @default(uuid()) @db.Uuid
  poId             String           @map("po_id") @db.Uuid
  itemId           String?          @map("item_id") @db.Uuid
  description      String
  quantity         Decimal          @db.Decimal(12,2)
  unitId           String?          @map("unit_id")
  ratePerUnit      Decimal          @map("rate_per_unit") @db.Decimal(12,2)
  receivedQuantity Decimal          @default(0) @map("received_quantity") @db.Decimal(12,2)
  sortOrder        Int              @default(0) @map("sort_order")
  po               MisPurchaseOrder @relation(fields: [poId], references: [id])
  item             MisItem?         @relation(fields: [itemId], references: [id])
  grnItems         MisGrnItem[]
  @@map("mis_po_items")
}

model MisGrn {
  id           String           @id @default(uuid()) @db.Uuid
  grnNumber    String           @unique @map("grn_number")
  poId         String           @map("po_id") @db.Uuid
  status       MisGrnStatus     @default(DRAFT)
  receivedAt   DateTime?        @map("received_at")
  receivedById String?          @map("received_by_id") @db.Uuid
  notes        String?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  po           MisPurchaseOrder @relation(fields: [poId], references: [id])
  items        MisGrnItem[]
  @@map("mis_grns")
}

model MisGrnItem {
  id          String         @id @default(uuid()) @db.Uuid
  grnId       String         @map("grn_id") @db.Uuid
  poItemId    String         @map("po_item_id") @db.Uuid
  receivedQty Decimal        @map("received_qty") @db.Decimal(12,2)
  type        MisGrnItemType @default(GENERAL)
  forOrderRef String?        @map("for_order_ref")
  batchNo     String?        @map("batch_no")
  notes       String?
  grn         MisGrn         @relation(fields: [grnId], references: [id])
  poItem      MisPoItem      @relation(fields: [poItemId], references: [id])
  @@map("mis_grn_items")
}

model MisInventoryLedger {
  id         String    @id @default(uuid()) @db.Uuid
  itemId     String    @map("item_id") @db.Uuid
  changeQty  Decimal   @map("change_qty") @db.Decimal(12,2)
  balanceQty Decimal   @map("balance_qty") @db.Decimal(12,2)
  source     String
  sourceId   String?   @map("source_id")
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  item       MisItem   @relation(fields: [itemId], references: [id])
  @@map("mis_inventory_ledger")
}

model MisStoreTransaction {
  id          String          @id @default(uuid()) @db.Uuid
  txnNumber   String          @unique @map("txn_number")
  itemId      String          @map("item_id") @db.Uuid
  type        MisStoreTxnType
  quantity    Decimal         @db.Decimal(12, 2)
  balanceQty  Decimal         @map("balance_qty") @db.Decimal(12, 2)
  referenceNo String?         @map("reference_no")
  reason      String?
  isOverIssue Boolean         @default(false) @map("is_over_issue")
  createdById String?         @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")
  item        MisItem         @relation(fields: [itemId], references: [id])
  @@map("mis_store_transactions")
}

model MisPhysicalCount {
  id          String    @id @default(uuid()) @db.Uuid
  itemId      String    @map("item_id") @db.Uuid
  countDate   DateTime  @map("count_date") @db.Date
  physicalQty Decimal   @map("physical_qty") @db.Decimal(12, 2)
  systemQty   Decimal   @map("system_qty") @db.Decimal(12, 2)
  discrepancy Decimal   @db.Decimal(12, 2)
  notes       String?
  countedById String?   @map("counted_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  item        MisItem   @relation(fields: [itemId], references: [id])
  @@map("mis_physical_counts")
}

model MisOrder {
  id           String       @id @default(uuid()) @db.Uuid
  orderNumber  String       @unique @map("order_number")
  customerId   String?      @map("customer_id") @db.Uuid
  status       String       @default("DRAFT")
  description  String?
