# Copy to .env.e2e (gitignored) and fill in real values before running `pnpm test:e2e`.
# Quote any password containing '#' — dotenv treats an unquoted '#' as a comment, even
# mid-value, and silently truncates everything after it.
E2E_BASE_URL=https://workspace-arjun.vercel.app
E2E_PASSWORD="change-me"

E2E_OWNER_EMAIL=e2e-owner@bhaskarpaper.test
E2E_ADMIN_EMAIL=e2e-admin@bhaskarpaper.test
E2E_SUPERVISOR_EMAIL=
E2E_SUPER_ATTENDANCE_OPERATOR_EMAIL=
E2E_ATTENDANCE_OPERATOR_EMAIL=
E2E_QC_EMAIL=
E2E_STORE_GUY_EMAIL=
