# =============================================================================
# Arjun — Environment Variables (Local Development)
# Copy to .env.local and fill in values. Never commit .env.local.
# =============================================================================

# --- Supabase Auth ---
# Get from: https://supabase.com → project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Database (Supabase Postgres) ---
# App runtime (Next.js): TRANSACTION pooler — port 6543 (set on Vercel as RUNTIME_DATABASE_URL).
# Not session mode (5432): session mode caps out at ~15 concurrent clients total across the
# whole project, which a serverless app with many warm function instances blows through fast
# (2026-09-29 incident). Safe here because src/server/db never names a prepared statement
# (see connection.ts) — an unnamed/ephemeral prepared statement is exactly what transaction-mode
# pooling requires. Same host/user/password as the session URL below, only the port differs.
RUNTIME_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD_URL_ENCODED@aws-0-REGION.pooler.supabase.com:6543/postgres
# Fallback if RUNTIME_DATABASE_URL is unset
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD_URL_ENCODED@aws-0-REGION.pooler.supabase.com:6543/postgres
# Prisma CLI (migrate, db pull, studio): same session URL
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD_URL_ENCODED@aws-0-REGION.pooler.supabase.com:5432/postgres
# Local Docker Postgres (all three can match):
# RUNTIME_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arjun
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arjun
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/arjun

# --- Object Storage ---
# STORAGE_DRIVER controls where uploaded files are stored:
#   local  → saves to .local-storage/ on disk (no Docker needed, good for dev)
#   s3     → uses S3-compatible storage (MinIO locally, IDrive e2 in prod)
# If omitted, auto-detects: s3 when all STORAGE_* vars are present, otherwise local.
STORAGE_DRIVER=local

# S3 mode only — uncomment and fill in for MinIO or IDrive e2:
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin
# STORAGE_BUCKET=arjun-dev

# --- Bootstrap ---
# Set to "true" to enable first-user admin creation on the login page.
# Remove or set to "false" after the first admin account is created.
ALLOW_BOOTSTRAP=true

# --- Internal API ---
# Secret used for automated cron jobs (trash purge, etc.)
CRON_SECRET=change-me-to-a-random-secret

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- MIS (Management Information System) ---
# Comma-separated list of user IDs to enable MIS feature for.
# Default: disabled for all users. Add user IDs here to enable (no redeploy needed).
# Example: MIS_ENABLED_ACCOUNTS=user-id-1,user-id-2,user-id-3
MIS_ENABLED_ACCOUNTS=
