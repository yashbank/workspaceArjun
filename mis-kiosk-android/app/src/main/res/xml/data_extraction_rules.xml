<?xml version="1.0" encoding="utf-8"?>
<!--
   The tablet's device token (encrypted prefs) and both Room databases (roster with faces,
   offline punch queue) must never leave the device through cloud backup or device-to-device
   transfer: a restored copy would resurrect a revoked tablet's credentials and stale queue.
   allowBackup is also false in the manifest; these rules are the belt-and-braces for Android 12+.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
