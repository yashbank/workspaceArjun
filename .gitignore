# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# prisma generated client
/src/generated/

# local filesystem storage (dev-only)
.local-storage/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local
.local-storage/
*.csv
*access*key*
*secret*

# BPP — exclude heavy GIF from production backgrounds (use MP4)
/public/assets/bpp/backgrounds/*.gif
/public/assets/bpp/frames/
public/assets/bpp/references/bpp-ambient-motion-reference.gif

