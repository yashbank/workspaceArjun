# =============================================================================
# Arjun — Production Environment Variables
# Set these in Vercel project settings → Environment Variables
# =============================================================================

# --- Supabase Auth ---
# Get from: Supabase Dashboard → project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Database (Supabase Postgres) ---
# Runtime (Vercel serverless): transaction pooler — port 6543
# Supabase Dashboard → Settings → Database → Connection string → Transaction mode
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD_URL_ENCODED@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Prisma CLI only (migrate deploy, db pull): session/direct — port 5432
# Use for local/CI migrations — NOT required on Vercel unless you run CLI against prod
# Supabase Dashboard → Settings → Database → Connection string → Session mode
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD_URL_ENCODED@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Object Storage (IDrive e2 — S3-compatible) ---
# Get from: IDrive e2 Dashboard → Access Keys
# Bucket must be pre-created in the IDrive e2 console.
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=https://YOUR_ENDPOINT.idrivee2.com
STORAGE_REGION=your-e2-region
STORAGE_ACCESS_KEY=your-idrive-e2-access-key
STORAGE_SECRET_KEY=your-idrive-e2-secret-key
STORAGE_BUCKET=arjun-files

# --- Internal API ---
# Random secret for automated cron jobs (trash purge). Generate with: openssl rand -hex 32
CRON_SECRET=your-random-secret-for-purge-cron

# --- App ---
# The public-facing URL (custom domain or Vercel default).
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# --- Security Notes ---
# ALLOW_BOOTSTRAP should NOT be set in production.
# Cloudflare Access protects the app at the network layer (see PRODUCTION_ENV_CHECKLIST.md).
